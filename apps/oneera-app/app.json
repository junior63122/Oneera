{
  "expo": {
    "name": "ONEERA",
    "slug": "oneera",
    "version": "2026.11.26",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#010922",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "cover",
      "backgroundColor": "#010922"
    },
    "assetBundlePatterns": [
      "web/**/*"
    ],
    "ios": {
      "bundleIdentifier": "com.mapping.festival",
      "buildNumber": "100",
      "supportsTablet": false,
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "fr.oneera.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#010922"
      }
    },
    "plugins": [
      "expo-asset"
    ],
    "owner": "juniorjoyants-team",
    "extra": {
      "eas": {
        "projectId": "6ea45fea-0cab-42c0-8bf0-216ffca69288"
      }
    }
  }
}
{
  "expo": {
    "name": "ONEERA",
    "slug": "oneera",
    "version": "2026.11.26",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#010922",
    "assetBundlePatterns": [
      "web/**/*"
    ],
    "ios": {
      "bundleIdentifier": "com.mapping.festival",
      "buildNumber": "102",
      "supportsTablet": false,
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "usesAppleSignIn": true
    },
    "android": {
      "package": "fr.oneera.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#010922"
      }
    },
    "plugins": [
      "expo-asset",
      [
        "expo-splash-screen",
        {
          "image": "./assets/icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#010922"
        }
      ],
      "expo-apple-authentication",
      [
        "expo-contacts",
        {
          "contactsPermission": "ONEERA compare des empreintes de tes contacts (jamais leurs noms ni numéros) pour te montrer ceux qui utilisent déjà ONEERA."
        }
      ]
    ],
    "owner": "juniorjoyants-team",
    "extra": {
      "eas": {
        "projectId": "6ea45fea-0cab-42c0-8bf0-216ffca69288"
      },
      "googleIosClientId": ""
    }
  }
}